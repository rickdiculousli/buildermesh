#!/bin/sh
# bmesh, faked for scripts/skilltest. A cell puts this first on PATH, so a
# session under test reaches no mesh, repo or thread: nothing it answers is
# real. Each call appends one line to $SKILLTEST_LOG as it exits: its exit
# status, the cwd, then each argument, tab-separated, with \, a tab and a
# newline written \\, \t and \n.
# It reads the cell's files under $SKILLTEST_CELL: fake.env (the row's name
# and path, this box's name, and in a lead's or a round's cell its node,
# worktree and a lead's spec), commands.txt (the arm's commands), canned/ (the case's outputs, by
# command) and state/ (counters, the commits its land pushed, and in
# pushed the commits it landed for a ledger write or another node).

cell=${SKILLTEST_CELL:?SKILLTEST_CELL is not set}
log=${SKILLTEST_LOG:-$cell/bmesh.log}
canned=$cell/canned
state=$cell/state
repo=
repo_path=
host=
node=
worktree=
lead_spec=
stop_first=0
round=0
. "$cell/fake.env"

esc() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/	/\\t/g' | sed -e ':a' -e '$!N' -e '$!ba' -e 's/\n/\\n/g'
}
line=$(esc "$PWD")
for a in "$@"; do
	line="$line	$(esc "$a")"
done
# The line is written on the way out, with the status the call exits with;
# a signal is an exit too, so a killed call is still logged.
trap 'printf "%s\t%s\n" $? "$line" >>"$log"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
	echo 'usage: bmesh [--config FILE] [--node PATH] [--json] <command> [args]'
	echo
	echo 'commands:'
	grep -v ' ' "$cell/commands.txt" | sed 's/^/  /'
}

# The flags that take no value; every other flag takes the next argument
# unless it is written --flag=value.
bools=' accepted force json idea peek here rerun dry-run minor patch all check write cancel apply yes defaults latest worktree wipe secure admin service no-repo restart detach plan walk before-swap notice notes checkouts ignored-ok '

isbool() {
	n=${1#-}
	n=${n#-}
	case $bools in *" $n "*) return 0 ;; esac
	return 1
}

# opt NAME ARGS...: print the value of --NAME, failing when it is absent.
opt() {
	name=$1
	shift
	while [ $# -gt 0 ]; do
		case $1 in
		--"$name" | -"$name")
			if [ $# -gt 1 ]; then
				printf '%s\n' "$2"
				return 0
			fi
			;;
		--"$name"=* | -"$name"=*)
			printf '%s\n' "${1#*=}"
			return 0
			;;
		esac
		shift
	done
	return 1
}

# has NAME ARGS...: whether --NAME is given.
has() {
	name=$1
	shift
	for a in "$@"; do
		if [ "$a" = "--$name" ] || [ "$a" = "-$name" ]; then
			return 0
		fi
	done
	return 1
}

# positionals ARGS...: the arguments that are neither a flag nor a flag's
# value, one per line.
positionals() {
	while [ $# -gt 0 ]; do
		case $1 in
		--)
			shift
			for a in "$@"; do
				printf '%s\n' "$a"
			done
			return 0
			;;
		-*=*) ;;
		-?*)
			if ! isbool "$1" && [ $# -gt 1 ]; then
				shift
			fi
			;;
		*) printf '%s\n' "$1" ;;
		esac
		shift
	done
}

first() { positionals "$@" | sed -n 1p; }

out() { [ -f "$canned/$1" ] && cat "$canned/$1"; }

# saysnext CMD: the arm's manual has CMD print its next: lines (100), as
# the binary that manual documents does.
saysnext() { grep -qxF -- "$1 next:" "$cell/commands.txt"; }

# watchnext PATHS: the watch line build and ideate end with on stderr.
watchnext() {
	echo "next: bmesh watch --nodes $1 --timeout 30m, under a Monitor where your harness has one, else in the background (never poll the runner); on exit 5, run it again with --since <its last line's time>" >&2
}

# leadsnext PATHS: the lines build ends with on stderr for the leads it
# started.
leadsnext() {
	saysnext build || return 0
	watchnext "$1"
	echo 'next: an ask goes to the operator in their words, and their answer back with bmesh --node operator send <path> "<answer>"; a blocked is reported with its reason, a done with its commit, a held or landing line only when asked' >&2
	echo 'next: to hold one, bmesh --node operator hold <path> --text "<why>" (before it lands; --gate now at once), released with bmesh --node operator unhold <path>; to stop one for good, bmesh --node operator node stop <path> --text "<why>", never a message; to wipe one, stop it, then bmesh node forget <path> --wipe (--dry-run first)' >&2
}

# next NAME: a counter in the cell's state, one more on each call.
next() {
	n=$(cat "$state/$1" 2>/dev/null || echo 0)
	n=$((n + 1))
	echo "$n" >"$state/$1"
	echo "$n"
}

uuid() { printf '5e7a%04d-0000-4000-8000-%012d\n' "$1" "$1"; }

sha8() { git ${2:+-C "$2"} rev-parse --verify -q "$1^{commit}" 2>/dev/null | cut -c1-8; }

pad() {
	n=$(printf '%s' "$1" | sed 's/^0*//')
	case $n in
	*[!0-9]*) printf '%s' "$1" ;;
	*) printf '%03d' "${n:-0}" ;;
	esac
}

# opts NAME ARGS...: every value of --NAME, one per line.
opts() {
	name=$1
	shift
	while [ $# -gt 0 ]; do
		case $1 in
		--"$name" | -"$name") [ $# -gt 1 ] && printf '%s\n' "$2" && shift ;;
		--"$name"=* | -"$name"=*) printf '%s\n' "${1#*=}" ;;
		esac
		shift
	done
}

# follow: the main checkout fast-forwarded to origin's main, as the binary
# has it follow a landing (a pull when it is on main, else a fetch into
# main); one that can't follow is left as it is.
follow() {
	if [ "$(git -C "$repo_path" branch --show-current 2>/dev/null)" = main ]; then
		git -C "$repo_path" pull -q --ff-only origin main
	else
		git -C "$repo_path" fetch -q origin main:main
	fi >/dev/null 2>&1 || :
}

# onmain MSG CMD [ARGS...]: a landing the fake makes for a ledger write or
# for another node, as the binary or that node makes it: CMD run in a fresh
# clone of origin's main, committed as MSG and pushed there, the main
# checkout following. It prints the commit's sha8 and keeps the commit in
# state/pushed, which scoring leaves out of the session's work.
onmain() {
	msg=$1
	shift
	clone=$state/clone
	rm -rf "$clone"
	ok=1
	if git clone -q "$cell/origin.git" "$clone" 2>/dev/null && (cd "$clone" && "$@") && git -C "$clone" add -A &&
		git -C "$clone" commit -qm "$msg" && git -C "$clone" push -q origin HEAD:main 2>/dev/null; then
		git -C "$clone" rev-parse HEAD >>"$state/pushed"
		sha8 HEAD "$clone"
		follow
		ok=0
	fi
	rm -rf "$clone"
	return $ok
}

# repodir [R]: the row's path for its name, R itself for a path, else this
# worktree's top.
repodir() {
	case $1 in
	"") git rev-parse --show-toplevel 2>/dev/null || pwd ;;
	"$repo") echo "$repo_path" ;;
	*) echo "$1" ;;
	esac
}

nonode() {
	echo "bmesh: no node for this directory; pass --node or set BMESH_NODE" >&2
	exit 2
}

json=0
gnode=
while [ $# -gt 0 ]; do
	case $1 in
	--json | -json) json=1 ;;
	--node | -node)
		gnode=${2-}
		[ $# -gt 1 ] && shift
		;;
	--node=* | -node=*) gnode=${1#*=} ;;
	--config | -config) [ $# -gt 1 ] && shift ;;
	--config=* | -config=*) ;;
	*) break ;;
	esac
	shift
done
if [ $# -eq 0 ]; then
	usage >&2
	exit 2
fi
cmd=$1
shift
for a in "$@"; do
	case $a in --json | -json) json=1 ;; esac
done
[ -n "$gnode" ] || gnode=$(opt node "$@")
# Inside the lead's worktree, bmesh knows the node, as the real one does.
if [ -z "$gnode" ] && [ -n "$node" ]; then
	case $PWD/ in "$worktree"/*) gnode=$node ;; esac
fi

case $cmd in
-h | -help | --help)
	usage
	exit 0
	;;
esac
if ! grep -qxF -- "$cmd" "$cell/commands.txt"; then
	echo "bmesh: unknown command \"$cmd\" (run \`bmesh help\`)" >&2
	exit 2
fi

fake_repos() {
	case ${1-} in
	show)
		name=$(positionals "$@" | sed -n 2p)
		if [ "$name" != "$repo" ]; then
			echo "bmesh: no repo \"$name\" in $cell/bmesh-config/repos.toml (bmesh repos lists them)" >&2
			exit 3
		fi
		if [ $json = 1 ]; then out repos-show.json; else out repos-show; fi
		;;
	"" | -*)
		if [ $json = 1 ]; then out repos.json; else out repos; fi
		;;
	esac
}

fake_spec() {
	sub=${1-}
	[ $# -gt 0 ] && shift
	case $sub in
	list)
		st=$(opt status "$@")
		# A round's thread checks the specs it wrote: in its cell a plain
		# list reads the checkout it names, as the binary does.
		if [ "$round" = 1 ] && [ -z "$st" ] && [ $json = 0 ]; then
			for f in "$(repodir "$(opt repo "$@")")"/docs/proposals/[0-9]*.md; do
				[ -f "$f" ] && specrow "$f"
			done
			exit 0
		fi
		key=spec-list${st:+.$st}
		[ $json = 1 ] && key=$key.json
		if [ ! -f "$canned/$key" ]; then
			echo "bmesh: --status \"$st\" is not one of proposed, accepted, adjusting, later, rejected, building, blocked, done" >&2
			exit 2
		fi
		cat "$canned/$key"
		;;
	next-id)
		dir=$(repodir "$(opt repo "$@")")
		count=$(opt count "$@") || count=1
		hi=$({
			for f in "$dir"/docs/proposals/*.md; do echo "${f##*/}"; done
			git -C "$dir" ls-tree --name-only origin/main -- docs/proposals/ 2>/dev/null | sed 's|.*/||'
		} | sed -n 's/^\([0-9][0-9]*\)-.*\.md$/\1/p' | sed 's/^0*//' | sort -n | tail -n 1)
		hi=${hi:-0}
		claimed=$(cat "$state/next-id" 2>/dev/null || echo 0)
		[ "$claimed" -gt "$hi" ] && hi=$claimed
		has peek "$@" || echo $((hi + count)) >"$state/next-id"
		if [ "$count" -gt 1 ]; then
			printf '%03d-%03d\n' $((hi + 1)) $((hi + count))
		else
			printf '%03d\n' $((hi + 1))
		fi
		;;
	template) out spec-template ;;
	set)
		ids=$(opt id "$@" | tr ',' ' ')
		st=$(opt status "$@")
		fields=$(opts field "$@")
		dir=$(repodir "$(opt repo "$@")")
		for id in $ids; do
			id=$(pad "$id")
			if has land "$@"; then
				if ! grep -q "^$id " "$canned/spec-list"; then
					echo "bmesh: no spec $id on main in $dir; bmesh spec list shows the ids" >&2
					exit 1
				fi
			elif [ -z "$(specfile "$dir" "$id")" ]; then
				echo "bmesh: no spec $id in $dir/docs/proposals; bmesh spec list shows the ids" >&2
				exit 1
			fi
		done
		landed=
		for id in $ids; do
			id=$(pad "$id")
			# Without --land the checkout's files are edited, as the binary
			# edits them; with it the edit lands on origin's main below.
			has land "$@" || setspec "$(specfile "$dir" "$id")"
			row=$(grep "^$id " "$canned/spec-list")
			printf '%s  %-9s  %s\n' "$id" "$st" "$(printf '%s' "$row" | cut -c17-)"
			landed=${landed:+$landed, }$id
		done
		if has land "$@"; then
			case $landed in
			*,*) msg="Specs $landed: $st" ;;
			*) msg="Spec $landed: $st" ;;
			esac
			if ! s=$(onmain "$msg" setspecs); then
				echo "bmesh: refused: push main: origin's main moved; run bmesh spec set --land again" >&2
				exit 3
			fi
			echo "landed $s on main: $msg"
		fi
		;;
	esac
}

# specrow FILE: the spec's line in spec list: id, status, size, kind, lens
# and title, as the binary prints it.
specrow() {
	awk '/^---$/ { n++; next } n == 1 { k = $1; sub(/:$/, "", k); v = $0; sub(/^[^:]*:[ \t]*/, "", v); f[k] = v }
		END { printf "%03d  %-9s  %-2s  %-11s  %-3s  %s\n", f["id"], f["status"], f["size"] ? f["size"] : "?", f["kind"] ? f["kind"] : "?", f["lens"] ? f["lens"] : "?", f["title"] }' "$1"
}

# specfile DIR ID: the spec's file in the checkout at DIR, if it has one.
specfile() { ls "$1"/docs/proposals/"$2"-*.md 2>/dev/null | sed -n 1p; }

# setfield FILE KEY VALUE: the frontmatter's KEY line rewritten, or added
# last when it has none, as the binary writes a field.
setfield() {
	awk -v k="$2" -v v="$3" '/^---$/ { n++; if (n == 2 && !set) print k ": " v; print; next }
		n == 1 && index($0, k ":") == 1 { print k ": " v; set = 1; next } { print }' "$1" >"$1.fake" && mv "$1.fake" "$1"
}

# setspec FILE: spec set's edit of one file: the status $st and each
# --field in $fields.
setspec() {
	setfield "$1" status "$st" || return 1
	printf '%s\n' "$fields" | while IFS= read -r kv; do
		[ -z "$kv" ] || setfield "$1" "${kv%%=*}" "${kv#*=}" || exit 1
	done
}

# setspecs: spec set --land's edit, in a clone of origin's main: each id in
# $ids.
setspecs() {
	for id in $ids; do
		f=$(specfile . "$(pad "$id")")
		[ -n "$f" ] && setspec "$f" || return 1
	done
}

# specstatus FILE: the frontmatter's status.
specstatus() { sed -n 's/^status: *//p' "$1" | sed -n 1p; }

# leadcheck ready|land ARGS...: the checks the binary makes of a lead's
# worktree before it lands: a clean tree, a branch and the spec reading
# done. In a case that stops first, the first ready or land is refused for
# the spec whatever the branch reads: the case stands for a lead whose done
# didn't take, which a session can't be made to be.
leadcheck() {
	what=$1
	shift
	top=$(git rev-parse --show-toplevel 2>/dev/null) || {
		echo "bmesh: refused: $PWD is not a worktree of a repo with a main checkout; run bmesh land in a lead's worktree" >&2
		exit 3
	}
	if [ -n "$(git -C "$top" status --porcelain)" ]; then
		if [ "$what" = ready ]; then
			echo "bmesh: refused: the worktree has changes not committed; commit them, then run bmesh ready again" >&2
		else
			echo "bmesh: worktree is dirty; commit first" >&2
		fi
		exit 3
	fi
	b=$(git -C "$top" branch --show-current)
	if [ -z "$b" ] || [ "$b" = main ]; then
		echo "bmesh: refused: land runs on a lead's branch, not ${b:--}; run it in your worktree, on your own branch" >&2
		exit 3
	fi
	id=$(opt spec "$@") && id=$(pad "$id") || id=$lead_spec
	f=$(specfile "$top" "$id")
	if [ -z "$f" ]; then
		echo "bmesh: refused: no spec $id in $top; a spec lands with its code: commit it on this branch (or rebase onto origin/main, if it landed there after you branched), then run bmesh $what again" >&2
		exit 3
	fi
	# lead-stop: the operator writes while the lead readies, so its first
	# ready or land meets the binary's stop for unread operator mail.
	if [ "$stop_first" = 1 ] && [ ! -f "$state/stopped" ]; then
		: >"$state/stopped"
		echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) operator: go ahead and land it as it is" >"$state/mail"
		echo "bmesh: refused: 1 unread message(s) from the operator; run bmesh inbox, act on them, then run bmesh $what again" >&2
		exit 3
	fi
	st=$(specstatus "$f")
	if [ "$st" != done ]; then
		echo "bmesh: refused: spec $id reads $st on $b; a spec lands with its code reading done: run bmesh spec set --id $id --status done, commit it, then run bmesh $what again" >&2
		exit 3
	fi
}

# fake_land: land for a lead whose land succeeds: verify on HEAD, the last
# commit reworded to carry the trailers, pushed to origin's main, the main
# checkout fast-forwarded, and the commit kept in state/landed.
fake_land() {
	if [ -z "$gnode" ] && ! opt spec "$@" >/dev/null; then
		echo "bmesh: land needs --spec NNN (no node spec resolves)" >&2
		exit 2
	fi
	leadcheck land "$@"
	tree=$(git -C "$top" rev-parse 'HEAD^{tree}' | cut -c1-8)
	echo "required: verify (the repo's verify kind)"
	if ! out=$(cd "$top" && go test ./... 2>&1); then
		printf '%s\nverify fail t:%s (recorded)\n' "$out" "$tree"
		echo "bmesh: verify failed at t:$tree; fix it, commit and run bmesh land again" >&2
		exit 1
	fi
	base=$(sha8 origin/main "$top")
	echo "verify ok t:$tree (recorded)"
	echo "review: none (size S)"
	echo "lease land.$repo"
	echo "fetch origin/main $base"
	echo "rebase: on $base already"
	echo "verify ok t:$tree (ran before the lease)"
	echo "verified: verify ok t:$tree"
	git -C "$top" log -1 --format=%B | git -C "$top" interpret-trailers --no-divider --if-exists replace \
		--trailer "Spec: $id" --trailer "Verified: verify ok t:$tree" | git -C "$top" commit -q --amend --no-verify --allow-empty -F -
	sha=$(git -C "$top" rev-parse HEAD)
	s8=$(echo "$sha" | cut -c1-8)
	echo "trailers $s8: Spec $id, Verified"
	if ! git -C "$top" push -q origin HEAD:refs/heads/main 2>/dev/null; then
		echo "bmesh: push main: refused; nothing is pushed: run bmesh land again" >&2
		exit 1
	fi
	echo "$sha" >>"$state/landed"
	echo "push origin main $s8"
	git -C "$repo_path" merge -q --ff-only "$sha" 2>/dev/null && echo "main $s8"
	echo "released land.$repo"
	echo land >>"$state/accepted"
	echo "landed $s8"
}

fake_ready() {
	[ -n "$gnode" ] || nonode
	if has cancel "$@"; then
		echo "cancelled: nothing is pushed; land in your own turn with bmesh land, or bmesh ready again"
		return 0
	fi
	leadcheck ready "$@"
	echo ready >>"$state/accepted"
	echo "ready: $host's daemon lands $(sha8 HEAD); it wakes you only if land needs you"
}

# fake_executor: an executor's worktree and branch under the lead's, made
# and removed as the binary makes and removes them.
fake_executor() {
	sub=${1-}
	[ $# -gt 0 ] && shift
	parent=${gnode:-operator}
	case $sub in
	new)
		name=$(opt name "$@")
		p=$parent.$name
		b=$(git branch --show-current 2>/dev/null)
		b=${b:-bmesh/$parent}-$name
		wt=$cell/worktrees/$repo/$p
		if git rev-parse --verify -q "refs/heads/$b" >/dev/null; then
			echo "bmesh: refused: branch $b already exists; remove it (git branch -d $b) or pick another name" >&2
			exit 3
		fi
		git worktree add -q -b "$b" "$wt" HEAD 2>/dev/null || mkdir -p "$wt"
		printf '{"path":"%s","branch":"%s","worktree":"%s"}\n' "$p" "$b" "$wt"
		if [ $json = 0 ] && [ -f "$cell/executor.md" ]; then
			# The arm's executor brief, filled in as the binary fills it.
			m=$(opt model "$@") && m="on \`$m\`" || m="on the model the piece calls for"
			sed -e "s|@PATH@|$p|g" -e "s|@WORKTREE@|$wt|g" -e "s|@BRANCH@|$b|g" -e "s|@MODEL@|$m|g" "$cell/executor.md"
		elif [ $json = 0 ]; then
			printf 'You are executor %s in buildermesh. Work only in %s on branch %s: every file path you touch is under it, and every shell command starts with `cd %s &&` (the working directory and environment do not persist between tool calls). Every bmesh command carries --node %s. Before anything else run `cd %s && bmesh --node %s started --text "<what you will do>"`. Report the finished piece with `bmesh --node %s done --commit <sha> --text "<one line>"` alone: the mesh puts it, with your branch, in your lead'"'"'s inbox. Read your brief below, then invoke the `buildermesh:executor` skill.\n' \
				"$p" "$wt" "$b" "$wt" "$p" "$wt" "$p" "$p"
		fi
		;;
	list)
		printf 'PATH  STATE  BRANCH  HEAD  UNREAD\n%s  working  %s  %s  0\n' "$parent" "$(git branch --show-current 2>/dev/null)" "$(sha8 HEAD)"
		;;
	remove)
		name=$(first "$@")
		p=$parent.$name
		wt=$cell/worktrees/$repo/$p
		b=$(git -C "$wt" branch --show-current 2>/dev/null)
		if [ -z "$b" ]; then
			echo "bmesh: refused: no executor $p under $parent with a worktree; bmesh executor list shows yours" >&2
			exit 3
		fi
		if ! has force "$@" && [ -z "$(git branch --list --merged HEAD "$b")" ]; then
			echo "bmesh: refused: branch $b is not merged into $(git branch --show-current); merge it (git merge $b), then remove it again, or pass --force to discard it" >&2
			exit 3
		fi
		git worktree remove --force "$wt" && git branch -q -D "$b"
		echo "removed $p"
		;;
	esac
}

fake_routine() {
	[ "${1-}" = run ] || return 0
	shift
	kind=$(first "$@")
	top=$(git rev-parse --show-toplevel 2>/dev/null) || {
		echo "bmesh: $PWD is not a git worktree" >&2
		exit 3
	}
	if [ ! -f "$top/.bmesh/routines/$kind.toml" ]; then
		echo "bmesh: no kind $kind in $top" >&2
		exit 3
	fi
	if [ "$kind" != verify ]; then
		mode=$(sed -n 's/^mode *= *"\(.*\)".*/\1/p' "$top/.bmesh/routines/$kind.toml")
		if ! has here "$@" && [ "$mode" != inline ]; then
			echo "bmesh: kind $kind is $mode; queue it, or pass --here to run it in this worktree" >&2
		else
			echo "bmesh: model run failed: no model answers a routine in this sandbox; nothing recorded" >&2
		fi
		exit 3
	fi
	if [ -n "$(git -C "$top" status --porcelain)" ]; then
		echo "bmesh: worktree is dirty; commit first" >&2
		exit 3
	fi
	tree=$(git -C "$top" rev-parse 'HEAD^{tree}' | cut -c1-8)
	if (cd "$top" && go test ./... 2>&1); then
		echo "verify ok t:$tree (recorded)"
		exit 0
	fi
	echo "verify fail t:$tree (recorded)"
	exit 1
}

child() {
	printf '{"path":"%s.%s","thread":"%s","branch":"%s-%s","worktree":"%s/worktrees/%s/%s-%s","host":"%s"}' \
		"$1" "$2" "$(uuid "$(next thread)")" "$1" "$2" "$cell" "$repo" "$1" "$2" "$host"
}

fake_ideate() {
	r=$(first "$@")
	n=$(next round)
	p=$r-round-$n
	if has idea "$@"; then
		printf '{"path":"%s","round":%s,"eng":%s}\n' "$p" "$n" "$(child "$p" eng)"
	else
		printf '{"path":"%s","round":%s,"eng":%s,"ux":%s}\n' "$p" "$n" "$(child "$p" eng)" "$(child "$p" ux)"
	fi
	if saysnext ideate; then watchnext "$p"; fi
}

# jstr S: S as a JSON string's body, escaped as Go's encoding/json does.
jstr() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/</\\u003c/g' -e 's/>/\\u003e/g' -e 's/&/\\u0026/g'
}

# spectitle ID: the spec's title on origin's main, else the ledger's.
spectitle() {
	f=$(git -C "$repo_path" ls-tree --name-only origin/main -- docs/proposals/ 2>/dev/null | grep "/$1-[^/]*\.md$" | sed -n 1p)
	if [ -n "$f" ]; then
		t=$(git -C "$repo_path" show "origin/main:$f" | awk 'NR == 1 && /^---$/ { fm = 1; next } fm && /^---$/ { exit } fm && /^title:/ { sub(/^title: */, ""); print; exit }')
		[ -n "$t" ] || t=$(basename "$f" .md | sed "s/^$1-//")
		printf '%s\n' "$t"
		return
	fi
	grep "^$1 " "$canned/spec-list" 2>/dev/null | cut -c39-
}

# fake_build: a lead started for each id, as the binary starts one whose
# spec nothing refuses (the fake has no live leads). One id prints its JSON
# object; several print a started line each and the family, or with
# --json one array of their objects. --accepted is answered from canned/
# only on an arm whose manual documents it; elsewhere it is the binary's
# unknown-flag refusal.
fake_build() {
	r=$(first "$@")
	if has accepted "$@"; then
		if ! grep -qxF -- 'build --accepted' "$cell/commands.txt"; then
			echo "bmesh: build: flag provided but not defined: -accepted" >&2
			exit 2
		fi
		out build-accepted || echo "no accepted specs in $r"
		return 0
	fi
	for id in $(positionals "$@" | sed 1d); do
		case $id in
		*[!0-9]*)
			echo "bmesh: spec id \"$id\" is not a number" >&2
			exit 2
			;;
		esac
	done
	ids=$(positionals "$@" | sed 1d | sed 's/^0*\([0-9]\)/\1/' | sort -n -u)
	n=$(printf '%s\n' "$ids" | grep -c .)
	if [ "$n" = 0 ]; then
		echo "bmesh: usage: bmesh build <repo> <NNN> [<NNN>...] [--model M] [--effort E] [--path P] [--family F] [--hold land|now] [--context <text|->] [--force]" >&2
		exit 2
	fi
	if [ "$n" -gt 1 ] && opt path "$@" >/dev/null; then
		echo "bmesh: --path names one lead; pick one spec with it" >&2
		exit 2
	fi
	fam=$(opt family "$@") || fam=$r-build-$(next family)
	model=$(opt model "$@") || model=claude-opus-5-5
	objs=
	paths=
	for id in $ids; do
		id=$(pad "$id")
		p=$(opt path "$@") || p=$r-$id
		paths=${paths:+$paths,}$p
		t=$(uuid "$(next thread)")
		fields=$(printf '"path":"%s","thread":"%s","branch":"bmesh/%s","worktree":"%s/worktrees/%s/%s","model":"%s","spec":"%s"' \
			"$p" "$t" "$t" "$cell" "$r" "$p" "$model" "$id")
		if [ "$n" = 1 ]; then
			printf '{%s,"family":"%s"}\n' "$fields" "$fam"
			leadsnext "$paths"
			return 0
		fi
		title=$(spectitle "$id")
		if [ $json = 1 ]; then
			objs=${objs:+$objs,}$(printf '{"id":"%s","title":"%s","state":"started","family":"%s",%s}' "$id" "$(jstr "$title")" "$fam" "$fields")
		else
			printf 'started %s %s: %s on %s (thread %s, branch bmesh/%s, family %s)\n' "$id" "$title" "$p" "$model" "$t" "$t" "$fam"
		fi
	done
	if [ $json = 1 ]; then
		printf '[%s]\n' "$objs"
	elif [ "$n" -gt 1 ]; then
		echo "family $fam"
	fi
	leadsnext "$paths"
}

fake_release() {
	r=$(first "$@")
	dir=$(repodir "$r")
	s=$(sha8 origin/main "$dir")
	[ -n "$s" ] || s=$(sha8 HEAD "$dir")
	if has dry-run "$@"; then
		echo "would release $r v0.1.0 at ${s:-00000000} (no specs); --dry-run tags nothing"
	else
		echo "released $r v0.1.0 at ${s:-00000000} (no specs)"
	fi
}

# The feedback queue: a case cans each family's pending issues as
# canned/feedback-list.<family> and each repo's as
# canned/feedback-list.repo.<repo>, one line per issue in the binary's
# formats, its sequence first. A drained sequence is kept in state/drained.

# drained SEQ: whether the sequence was drained.
drained() { grep -qx "$1" "$state/drained" 2>/dev/null; }

# landedseqs: the sequences origin's main names, one per line: in a spec's
# from_feedback, or in a fix commit's subject (Fix #a, #b: ... or Quick fix
# from <family> #a: ...).
landedseqs() {
	og=$cell/origin.git
	{
		git --git-dir "$og" log --format=%s main 2>/dev/null |
			sed -n -e 's/^Fix \(#[0-9][0-9]*\(, #[0-9][0-9]*\)*\): .*/\1/p' -e 's/^Quick fix from [^ ]* \(#[0-9][0-9]*\(, #[0-9][0-9]*\)*\): .*/\1/p'
		for f in $(git --git-dir "$og" ls-tree -r --name-only main -- docs/proposals/ 2>/dev/null); do
			git --git-dir "$og" show "main:$f" | awk 'NR == 1 && /^---$/ { fm = 1; next } fm && /^---$/ { exit } fm && /^from_feedback:/ { print }'
		done
	} | grep -o '#[0-9][0-9]*' | tr -d '#'
}

# pending FILE [landed]: FILE's canned lines still pending: not drained
# and, with landed, not named on origin's main.
pending() {
	[ -f "$1" ] || return 0
	skip=$(cat "$state/drained" 2>/dev/null)
	[ -z "${2-}" ] || skip="$skip $(landedseqs)"
	skip=" $(echo $skip) "
	while IFS= read -r l; do
		case $skip in *" ${l%% *} "*) continue ;; esac
		printf '%s\n' "$l"
	done <"$1"
}

fake_feedback_list() {
	shift
	if r=$(opt repo "$@"); then
		case $r in . | "$repo_path" | "$worktree") r=$repo ;; esac
		pending "$canned/feedback-list.repo.$r" landed
		return 0
	fi
	f=$(first "$@")
	f=${f:-$gnode}
	list=$(pending "$canned/feedback-list.$f")
	[ -n "$list" ] || return 0
	printf '%s\n' "$list"
	# A family's list that isn't a fixer's ends with the steps of draining
	# it (100), on an arm whose manual documents them; no row here holds
	# bmesh's module.
	case $f in *-fix-[0-9]*) return 0 ;; esac
	if [ $json = 0 ] && saysnext feedback; then
		echo "next: an issue naming bmesh's own repo is its fixer's: leave it pending. Of the rest, merge duplicates and drop what main already covers (a spec, or a commit naming its #<seq>)" >&2
		echo "next: make each one-cause XS or S issue as the work skill's rung 3 makes a change, titled Quick fix from $f #<seq>: <what it changes>; write each other one as a proposed spec with from_feedback: $f (<its leads>) #<seq>, landed as Feedback NNN: proposed from $f, for the operator to pick" >&2
		echo "next: then bmesh feedback drain --seq <the sequences you ruled on>, and report one line per issue: fixed by <sha8>, proposed NNN, already NNN, dropped: <why> or to the fixer" >&2
	fi
}

# fake_feedback_drain: --seq deletes exactly those sequences, a family
# its pending issues up to --through; drained ones are not pending.
fake_feedback_drain() {
	shift
	if seqs=$(opt seq "$@"); then
		n=0
		gone=
		for s in $(printf '%s' "$seqs" | tr ',#' '  '); do
			if ! drained "$s" && cat "$canned"/feedback-list.* 2>/dev/null | grep -q "^$s "; then
				echo "$s" >>"$state/drained"
				n=$((n + 1))
			else
				gone=${gone:+$gone,}$s
			fi
		done
		echo "drained $n"
		[ -z "$gone" ] || echo "not pending: $gone"
		return 0
	fi
	f=$(first "$@")
	through=$(opt through "$@") || through=
	n=0
	for s in $(pending "$canned/feedback-list.$f" | cut -d' ' -f1); do
		[ -n "$through" ] && [ "$s" -gt "$through" ] && continue
		echo "$s" >>"$state/drained"
		n=$((n + 1))
	done
	echo "drained $n from $f"
}

# fake_watch: the case's canned watch. When the case cans watch-land (spec
# ids), what it watches lands first, once: each id with a spec on origin's
# main is a lead's, landed as its land does, a commit setting the spec done
# whose sha8 stands in for @LANDED@ on that id's done line; the ids with
# none are a round's, its pitch lines landed as proposed specs in one
# commit, as the round's thread lands them.
fake_watch() {
	if [ ! -f "$state/watch-landed" ] && [ -f "$canned/watch-land" ]; then
		: >"$state/watch-landed"
		new=
		for id in $(cat "$canned/watch-land"); do
			id=$(pad "$id")
			f=$(git --git-dir "$cell/origin.git" ls-tree --name-only main -- docs/proposals/ | grep "/$id-[^/]*\.md$" | sed -n 1p)
			if [ -n "$f" ]; then
				s=$(onmain "$(spectitle "$id")

Spec: $id" setfield "$f" status done) && echo "$id $s" >>"$state/watch-landed"
			else
				new=${new:+$new, }$id
			fi
		done
		[ -z "$new" ] || onmain "Proposals $new: proposed" proposespecs >/dev/null
	fi
	# An arm whose manual has no next: on watch-done gets the bare line.
	if saysnext watch; then out watch; else out watch | sed 's/^watch-done; next: .*/watch-done/'; fi | {
		script=
		[ ! -f "$state/watch-landed" ] || while read -r id s; do
			script="$script/ done $id /s/@LANDED@/$s/;"
		done <"$state/watch-landed"
		sed -e "${script}s/@LANDED@/00000000/g"
	}
}

# proposespecs: a round's landing, in a clone of origin's main: a proposed
# spec for each id in $new, from its line of the watch's pitch
# (`NNN title (kind, size, judge): why`).
proposespecs() {
	for id in $(echo "$new" | tr ',' ' '); do
		text=$(out watch | awk -v id="$id" '{ p = index(" " $0, " " id " "); if (!p) next
			r = substr($0, p + length(id) + 1)
			if (!match(r, / \([a-z]+, [A-Z]+, [a-z]+\): /)) next
			split(substr(r, RSTART + 2, RLENGTH - 5), f, ", ")
			printf "---\nid: %s\ntitle: %s\nkind: %s\nsize: %s\njudge: %s\nstatus: proposed\nlens: eng\n---\n\n## Opportunity\n%s\n", id, substr(r, 1, RSTART - 1), f[1], f[2], f[3], substr(r, RSTART + RLENGTH)
			exit }')
		[ -n "$text" ] || continue
		slug=$(printf '%s\n' "$text" | sed -n 's/^title: //p' | tr 'A-Z' 'a-z' | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' | cut -c1-48 | sed 's/-$//')
		printf '%s\n' "$text" >"docs/proposals/$id-$slug.md"
	done
}

# fake_choose_ideas: the case's canned choose-ideas, its moves
# (`NNN title: proposed -> <status>`) landed on origin's main, a
# rejection's --reject NNN=<reason> written as its reason, and the landed
# line naming that commit.
fake_choose_ideas() {
	text=$(out choose-ideas) || {
		echo "nothing to land"
		return 0
	}
	rejects=$(opts reject "$@")
	moves=$(printf '%s\n' "$text" | sed -n 's/^\([0-9][0-9]*\) .*: proposed -> \([a-z]*\)$/\1 \2/p')
	msg=$(printf '%s\n' "$text" | sed -n 's/^landed [0-9a-f]* on main: //p')
	if ! s=$(onmain "$msg" choose); then
		echo "bmesh: refused: push main: origin's main moved; run bmesh choose-ideas again" >&2
		exit 3
	fi
	printf '%s\n' "$text" | sed "s/^landed [0-9a-f]* on main: /landed $s on main: /"
}

# choose: choose-ideas' edit, in a clone of origin's main.
choose() {
	printf '%s\n' "$moves" | while read -r id st; do
		f=$(specfile . "$id")
		[ -n "$f" ] && setfield "$f" status "$st" || exit 1
		[ "$st" = rejected ] || continue
		printf '%s\n' "$rejects" | while IFS= read -r r; do
			case $r in "$id="* | "${id#0}="* | "${id#00}="*) setfield "$f" reason "${r#*=}" ;; esac
		done
	done
}

case $cmd in
help) usage ;;
version) echo "bmesh (skilltest's fake)" ;;
hosts)
	if has here "$@"; then
		out hosts-here || echo "this box is $host; secure: no; on the mesh: no other box"
	elif has notes "$@"; then
		echo "$host: no notes"
	else
		printf 'NAME  PRESENCE  ROLE\n%s   awake     admin\n' "$host"
	fi
	;;
update) has notice "$@" || echo "up to date" ;;
repos) fake_repos "$@" ;;
mesh-status) if [ $json = 1 ]; then out mesh-status.json; else out mesh-status; fi ;;
thread-status)
	p=$(first "$@")
	[ -n "$p" ] || p=$gnode
	[ -n "$p" ] || nonode
	if [ $json = 1 ]; then
		out "thread-status.$p.json" || echo '{"state":"idle","at":"","text":"","by":""}'
	else
		out "thread-status.$p" || echo idle
	fi
	;;
watch) fake_watch ;;
inbox)
	if [ -f "$state/mail" ]; then
		cat "$state/mail"
		rm -f "$state/mail"
	else
		out inbox || { [ $json = 1 ] || echo "inbox: empty"; }
	fi
	;;
spec) fake_spec "$@" ;;
routine) fake_routine "$@" ;;
ideate) fake_ideate "$@" ;;
build) fake_build "$@" ;;
lead)
	if [ "${1-}" = start ]; then
		p=$(opt path "$@") || p=$(opt repo "$@")-$(pad "$(opt spec "$@")")
		t=$(uuid "$(next thread)")
		printf '{"path":"%s","thread":"%s","branch":"bmesh/%s","worktree":"%s/worktrees/%s/%s"}\n' "$p" "$t" "$t" "$cell" "$repo" "$p"
	fi
	;;
executor) fake_executor "$@" ;;
choose-ideas) fake_choose_ideas "$@" ;;
land) fake_land "$@" ;;
ready) fake_ready "$@" ;;
held)
	[ -n "$gnode" ] || nonode
	echo "bmesh: refused: $gnode is not held (released already?); run bmesh inbox and carry on" >&2
	exit 3
	;;
done)
	[ -n "$gnode" ] || nonode
	echo "done $gnode $(opt commit "$@" | cut -c1-8)"
	;;
started | progress | blocked | ask)
	[ -n "$gnode" ] || nonode
	echo "$cmd $gnode"
	;;
audit) out audit || echo 'audit: no session bmesh can read (Claude Code names its session in CLAUDE_CODE_SESSION_ID)' ;;
whoami)
	[ -n "$gnode" ] || nonode
	echo "$gnode"
	;;
release) fake_release "$@" ;;
hold)
	p=$(opt family "$@") || p=$(first "$@")
	if [ "$(opt gate "$@")" = now ]; then
		echo "holding $p now: $(opt text "$@")"
	else
		echo "holding $p before land: $(opt text "$@")"
	fi
	;;
unhold)
	p=$(opt family "$@") || p=$(first "$@")
	echo "released $p"
	;;
node) [ "${1-}" = stop ] && echo "stopped $(positionals "$@" | sed -n 2p)" ;;
feedback)
	case ${1-} in
	list) fake_feedback_list "$@" ;;
	drain) fake_feedback_drain "$@" ;;
	*) echo "feedback $(next feedback) in $repo-build-1" ;;
	esac
	;;
fix) echo "fix: $repo-fix-$(next fix) started (thread $(uuid "$(next thread)"), claude-opus-5-5, on $host)" ;;
send) echo "sent $(uuid "$(next message)")" ;;
esac
exit 0
