#!/bin/sh
# bmesh, faked for scripts/skilltest. A cell puts this first on PATH, so a
# session under test reaches no mesh, repo or thread: nothing it answers is
# real. Each call appends one line to $SKILLTEST_LOG: the cwd, then each
# argument, tab-separated, with \, a tab and a newline written \\, \t and \n.
# It reads the cell's files under $SKILLTEST_CELL: fake.env (the row's name
# and path, this box's name, and in a lead's cell its node, worktree and
# spec), commands.txt (the arm's commands), canned/ (the case's outputs, by
# command) and state/ (counters, and the commits its land pushed).

cell=${SKILLTEST_CELL:?SKILLTEST_CELL is not set}
log=${SKILLTEST_LOG:-$cell/bmesh.log}
canned=$cell/canned
state=$cell/state
repo=
repo_path=
host=
node=
worktree=
lead_spec=
stop_first=0
. "$cell/fake.env"

esc() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/	/\\t/g' | sed -e ':a' -e '$!N' -e '$!ba' -e 's/\n/\\n/g'
}
line=$(esc "$PWD")
for a in "$@"; do
	line="$line	$(esc "$a")"
done
printf '%s\n' "$line" >>"$log"

usage() {
	echo 'usage: bmesh [--config FILE] [--node PATH] [--json] <command> [args]'
	echo
	echo 'commands:'
	grep -v ' ' "$cell/commands.txt" | sed 's/^/  /'
}

# The flags that take no value; every other flag takes the next argument
# unless it is written --flag=value.
bools=' accepted force json idea peek here rerun dry-run minor patch all check write cancel apply yes defaults latest worktree wipe secure admin service no-repo restart detach plan walk before-swap notice notes checkouts ignored-ok '

isbool() {
	n=${1#-}
	n=${n#-}
	case $bools in *" $n "*) return 0 ;; esac
	return 1
}

# opt NAME ARGS...: print the value of --NAME, failing when it is absent.
opt() {
	name=$1
	shift
	while [ $# -gt 0 ]; do
		case $1 in
		--"$name" | -"$name")
			if [ $# -gt 1 ]; then
				printf '%s\n' "$2"
				return 0
			fi
			;;
		--"$name"=* | -"$name"=*)
			printf '%s\n' "${1#*=}"
			return 0
			;;
		esac
		shift
	done
	return 1
}

# has NAME ARGS...: whether --NAME is given.
has() {
	name=$1
	shift
	for a in "$@"; do
		if [ "$a" = "--$name" ] || [ "$a" = "-$name" ]; then
			return 0
		fi
	done
	return 1
}

# positionals ARGS...: the arguments that are neither a flag nor a flag's
# value, one per line.
positionals() {
	while [ $# -gt 0 ]; do
		case $1 in
		--)
			shift
			for a in "$@"; do
				printf '%s\n' "$a"
			done
			return 0
			;;
		-*=*) ;;
		-?*)
			if ! isbool "$1" && [ $# -gt 1 ]; then
				shift
			fi
			;;
		*) printf '%s\n' "$1" ;;
		esac
		shift
	done
}

first() { positionals "$@" | sed -n 1p; }

out() { [ -f "$canned/$1" ] && cat "$canned/$1"; }

# next NAME: a counter in the cell's state, one more on each call.
next() {
	n=$(cat "$state/$1" 2>/dev/null || echo 0)
	n=$((n + 1))
	echo "$n" >"$state/$1"
	echo "$n"
}

uuid() { printf '5e7a%04d-0000-4000-8000-%012d\n' "$1" "$1"; }

fakesha() { od -An -N20 -tx1 /dev/urandom | tr -d ' \n'; }

sha8() { git ${2:+-C "$2"} rev-parse --verify -q "$1^{commit}" 2>/dev/null | cut -c1-8; }

pad() {
	n=$(printf '%s' "$1" | sed 's/^0*//')
	case $n in
	*[!0-9]*) printf '%s' "$1" ;;
	*) printf '%03d' "${n:-0}" ;;
	esac
}

# repodir [R]: the row's path for its name, R itself for a path, else this
# worktree's top.
repodir() {
	case $1 in
	"") git rev-parse --show-toplevel 2>/dev/null || pwd ;;
	"$repo") echo "$repo_path" ;;
	*) echo "$1" ;;
	esac
}

nonode() {
	echo "bmesh: no node for this directory; pass --node or set BMESH_NODE" >&2
	exit 2
}

json=0
gnode=
while [ $# -gt 0 ]; do
	case $1 in
	--json | -json) json=1 ;;
	--node | -node)
		gnode=${2-}
		[ $# -gt 1 ] && shift
		;;
	--node=* | -node=*) gnode=${1#*=} ;;
	--config | -config) [ $# -gt 1 ] && shift ;;
	--config=* | -config=*) ;;
	*) break ;;
	esac
	shift
done
if [ $# -eq 0 ]; then
	usage >&2
	exit 2
fi
cmd=$1
shift
for a in "$@"; do
	case $a in --json | -json) json=1 ;; esac
done
[ -n "$gnode" ] || gnode=$(opt node "$@")
# Inside the lead's worktree, bmesh knows the node, as the real one does.
if [ -z "$gnode" ] && [ -n "$node" ]; then
	case $PWD/ in "$worktree"/*) gnode=$node ;; esac
fi

case $cmd in
-h | -help | --help)
	usage
	exit 0
	;;
esac
if ! grep -qxF -- "$cmd" "$cell/commands.txt"; then
	echo "bmesh: unknown command \"$cmd\" (run \`bmesh help\`)" >&2
	exit 2
fi

fake_repos() {
	case ${1-} in
	show)
		name=$(positionals "$@" | sed -n 2p)
		if [ "$name" != "$repo" ]; then
			echo "bmesh: no repo \"$name\" in $cell/bmesh-config/repos.toml (bmesh repos lists them)" >&2
			exit 3
		fi
		if [ $json = 1 ]; then out repos-show.json; else out repos-show; fi
		;;
	"" | -*)
		if [ $json = 1 ]; then out repos.json; else out repos; fi
		;;
	esac
}

fake_spec() {
	sub=${1-}
	[ $# -gt 0 ] && shift
	case $sub in
	list)
		st=$(opt status "$@")
		key=spec-list${st:+.$st}
		[ $json = 1 ] && key=$key.json
		if [ ! -f "$canned/$key" ]; then
			echo "bmesh: --status \"$st\" is not one of proposed, accepted, adjusting, later, rejected, building, blocked, done" >&2
			exit 2
		fi
		cat "$canned/$key"
		;;
	next-id)
		dir=$(repodir "$(opt repo "$@")")
		count=$(opt count "$@") || count=1
		hi=$({
			for f in "$dir"/docs/proposals/*.md; do echo "${f##*/}"; done
			git -C "$dir" ls-tree --name-only origin/main -- docs/proposals/ 2>/dev/null | sed 's|.*/||'
		} | sed -n 's/^\([0-9][0-9]*\)-.*\.md$/\1/p' | sed 's/^0*//' | sort -n | tail -n 1)
		hi=${hi:-0}
		claimed=$(cat "$state/next-id" 2>/dev/null || echo 0)
		[ "$claimed" -gt "$hi" ] && hi=$claimed
		has peek "$@" || echo $((hi + count)) >"$state/next-id"
		if [ "$count" -gt 1 ]; then
			printf '%03d-%03d\n' $((hi + 1)) $((hi + count))
		else
			printf '%03d\n' $((hi + 1))
		fi
		;;
	template) out spec-template ;;
	set)
		ids=$(opt id "$@" | tr ',' ' ')
		st=$(opt status "$@")
		dir=$(repodir "$(opt repo "$@")")
		for id in $ids; do
			id=$(pad "$id")
			if has land "$@"; then
				if ! grep -q "^$id " "$canned/spec-list"; then
					echo "bmesh: no spec $id on main in $dir; bmesh spec list shows the ids" >&2
					exit 1
				fi
			elif [ -z "$(specfile "$dir" "$id")" ]; then
				echo "bmesh: no spec $id in $dir/docs/proposals; bmesh spec list shows the ids" >&2
				exit 1
			fi
		done
		landed=
		for id in $ids; do
			id=$(pad "$id")
			# Without --land the checkout's files are edited, as the binary
			# edits them; with it the edit is a ledger commit, faked.
			has land "$@" || setstatus "$(specfile "$dir" "$id")" "$st"
			row=$(grep "^$id " "$canned/spec-list")
			printf '%s  %-9s  %s\n' "$id" "$st" "$(printf '%s' "$row" | cut -c17-)"
			landed=${landed:+$landed, }$id
		done
		if has land "$@"; then
			case $landed in
			*,*) echo "landed $(fakesha | cut -c1-8) on main: Specs $landed: $st" ;;
			*) echo "landed $(fakesha | cut -c1-8) on main: Spec $landed: $st" ;;
			esac
		fi
		;;
	esac
}

# specfile DIR ID: the spec's file in the checkout at DIR, if it has one.
specfile() { ls "$1"/docs/proposals/"$2"-*.md 2>/dev/null | sed -n 1p; }

# setstatus FILE STATUS: the frontmatter's status line rewritten.
setstatus() {
	awk -v st="$2" '/^---$/ { n++ } n == 1 && /^status:/ { print "status: " st; next } { print }' "$1" >"$1.fake" && mv "$1.fake" "$1"
}

# specstatus FILE: the frontmatter's status.
specstatus() { sed -n 's/^status: *//p' "$1" | sed -n 1p; }

# leadcheck ready|land ARGS...: the checks the binary makes of a lead's
# worktree before it lands: a clean tree, a branch and the spec reading
# done. In a case that stops first, the first ready or land is refused for
# the spec whatever the branch reads: the case stands for a lead whose done
# didn't take, which a session can't be made to be.
leadcheck() {
	what=$1
	shift
	top=$(git rev-parse --show-toplevel 2>/dev/null) || {
		echo "bmesh: refused: $PWD is not a worktree of a repo with a main checkout; run bmesh land in a lead's worktree" >&2
		exit 3
	}
	if [ -n "$(git -C "$top" status --porcelain)" ]; then
		if [ "$what" = ready ]; then
			echo "bmesh: refused: the worktree has changes not committed; commit them, then run bmesh ready again" >&2
		else
			echo "bmesh: worktree is dirty; commit first" >&2
		fi
		exit 3
	fi
	b=$(git -C "$top" branch --show-current)
	if [ -z "$b" ] || [ "$b" = main ]; then
		echo "bmesh: refused: land runs on a lead's branch, not ${b:--}; run it in your worktree, on your own branch" >&2
		exit 3
	fi
	id=$(opt spec "$@") && id=$(pad "$id") || id=$lead_spec
	f=$(specfile "$top" "$id")
	if [ -z "$f" ]; then
		echo "bmesh: refused: no spec $id in $top; a spec lands with its code: commit it on this branch (or rebase onto origin/main, if it landed there after you branched), then run bmesh $what again" >&2
		exit 3
	fi
	# lead-stop: the operator writes while the lead readies, so its first
	# ready or land meets the binary's stop for unread operator mail.
	if [ "$stop_first" = 1 ] && [ ! -f "$state/stopped" ]; then
		: >"$state/stopped"
		echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) operator: go ahead and land it as it is" >"$state/mail"
		echo "bmesh: refused: 1 unread message(s) from the operator; run bmesh inbox, act on them, then run bmesh $what again" >&2
		exit 3
	fi
	st=$(specstatus "$f")
	if [ "$st" != done ]; then
		echo "bmesh: refused: spec $id reads $st on $b; a spec lands with its code reading done: run bmesh spec set --id $id --status done, commit it, then run bmesh $what again" >&2
		exit 3
	fi
}

# fake_land: land for a lead whose land succeeds: verify on HEAD, the last
# commit reworded to carry the trailers, pushed to origin's main, the main
# checkout fast-forwarded, and the commit kept in state/landed.
fake_land() {
	if [ -z "$gnode" ] && ! opt spec "$@" >/dev/null; then
		echo "bmesh: land needs --spec NNN (no node spec resolves)" >&2
		exit 2
	fi
	leadcheck land "$@"
	tree=$(git -C "$top" rev-parse 'HEAD^{tree}' | cut -c1-8)
	echo "required: verify (the repo's verify kind)"
	if ! out=$(cd "$top" && go test ./... 2>&1); then
		printf '%s\nverify fail t:%s (recorded)\n' "$out" "$tree"
		echo "bmesh: verify failed at t:$tree; fix it, commit and run bmesh land again" >&2
		exit 1
	fi
	base=$(sha8 origin/main "$top")
	echo "verify ok t:$tree (recorded)"
	echo "review: none (size S)"
	echo "lease land.$repo"
	echo "fetch origin/main $base"
	echo "rebase: on $base already"
	echo "verify ok t:$tree (ran before the lease)"
	echo "verified: verify ok t:$tree"
	git -C "$top" log -1 --format=%B | git -C "$top" interpret-trailers --no-divider --if-exists replace \
		--trailer "Spec: $id" --trailer "Verified: verify ok t:$tree" | git -C "$top" commit -q --amend --no-verify --allow-empty -F -
	sha=$(git -C "$top" rev-parse HEAD)
	s8=$(echo "$sha" | cut -c1-8)
	echo "trailers $s8: Spec $id, Verified"
	if ! git -C "$top" push -q origin HEAD:refs/heads/main 2>/dev/null; then
		echo "bmesh: push main: refused; nothing is pushed: run bmesh land again" >&2
		exit 1
	fi
	echo "$sha" >>"$state/landed"
	echo "push origin main $s8"
	git -C "$repo_path" merge -q --ff-only "$sha" 2>/dev/null && echo "main $s8"
	echo "released land.$repo"
	echo land >>"$state/accepted"
	echo "landed $s8"
}

fake_ready() {
	[ -n "$gnode" ] || nonode
	if has cancel "$@"; then
		echo "cancelled: nothing is pushed; land in your own turn with bmesh land, or bmesh ready again"
		return 0
	fi
	leadcheck ready "$@"
	echo ready >>"$state/accepted"
	echo "ready: $host's daemon lands $(sha8 HEAD); it wakes you only if land needs you"
}

# fake_executor: an executor's worktree and branch under the lead's, made
# and removed as the binary makes and removes them.
fake_executor() {
	sub=${1-}
	[ $# -gt 0 ] && shift
	parent=${gnode:-operator}
	case $sub in
	new)
		name=$(opt name "$@")
		p=$parent.$name
		b=$(git branch --show-current 2>/dev/null)
		b=${b:-bmesh/$parent}-$name
		wt=$cell/worktrees/$repo/$p
		if git rev-parse --verify -q "refs/heads/$b" >/dev/null; then
			echo "bmesh: refused: branch $b already exists; remove it (git branch -d $b) or pick another name" >&2
			exit 3
		fi
		git worktree add -q -b "$b" "$wt" HEAD 2>/dev/null || mkdir -p "$wt"
		printf '{"path":"%s","branch":"%s","worktree":"%s"}\n' "$p" "$b" "$wt"
		if [ $json = 0 ]; then
			printf 'You are executor %s in buildermesh. Work only in %s on branch %s: every file path you touch is under it, and every shell command starts with `cd %s &&` (the working directory and environment do not persist between tool calls). Every bmesh command carries --node %s. Before anything else run `cd %s && bmesh --node %s started --text "<what you will do>"`. Report the finished piece with `bmesh --node %s done --commit <sha> --text "<one line>"` alone: the mesh puts it, with your branch, in your lead'"'"'s inbox. Read your brief below, then invoke the `buildermesh:executor` skill.\n' \
				"$p" "$wt" "$b" "$wt" "$p" "$wt" "$p" "$p"
		fi
		;;
	list)
		printf 'PATH  STATE  BRANCH  HEAD  UNREAD\n%s  working  %s  %s  0\n' "$parent" "$(git branch --show-current 2>/dev/null)" "$(sha8 HEAD)"
		;;
	remove)
		name=$(first "$@")
		p=$parent.$name
		wt=$cell/worktrees/$repo/$p
		b=$(git -C "$wt" branch --show-current 2>/dev/null)
		if [ -z "$b" ]; then
			echo "bmesh: refused: no executor $p under $parent with a worktree; bmesh executor list shows yours" >&2
			exit 3
		fi
		if ! has force "$@" && [ -z "$(git branch --list --merged HEAD "$b")" ]; then
			echo "bmesh: refused: branch $b is not merged into $(git branch --show-current); merge it (git merge $b), then remove it again, or pass --force to discard it" >&2
			exit 3
		fi
		git worktree remove --force "$wt" && git branch -q -D "$b"
		echo "removed $p"
		;;
	esac
}

fake_routine() {
	[ "${1-}" = run ] || return 0
	shift
	kind=$(first "$@")
	top=$(git rev-parse --show-toplevel 2>/dev/null) || {
		echo "bmesh: $PWD is not a git worktree" >&2
		exit 3
	}
	if [ ! -f "$top/.bmesh/routines/$kind.toml" ]; then
		echo "bmesh: no kind $kind in $top" >&2
		exit 3
	fi
	if [ "$kind" != verify ]; then
		mode=$(sed -n 's/^mode *= *"\(.*\)".*/\1/p' "$top/.bmesh/routines/$kind.toml")
		if ! has here "$@" && [ "$mode" != inline ]; then
			echo "bmesh: kind $kind is $mode; queue it, or pass --here to run it in this worktree" >&2
		else
			echo "bmesh: model run failed: no model answers a routine in this sandbox; nothing recorded" >&2
		fi
		exit 3
	fi
	if [ -n "$(git -C "$top" status --porcelain)" ]; then
		echo "bmesh: worktree is dirty; commit first" >&2
		exit 3
	fi
	tree=$(git -C "$top" rev-parse 'HEAD^{tree}' | cut -c1-8)
	if (cd "$top" && go test ./... 2>&1); then
		echo "verify ok t:$tree (recorded)"
		exit 0
	fi
	echo "verify fail t:$tree (recorded)"
	exit 1
}

child() {
	printf '{"path":"%s.%s","thread":"%s","branch":"%s-%s","worktree":"%s/worktrees/%s/%s-%s","host":"%s"}' \
		"$1" "$2" "$(uuid "$(next thread)")" "$1" "$2" "$cell" "$repo" "$1" "$2" "$host"
}

fake_ideate() {
	r=$(first "$@")
	n=$(next round)
	p=$r-round-$n
	if has idea "$@"; then
		printf '{"path":"%s","round":%s,"eng":%s}\n' "$p" "$n" "$(child "$p" eng)"
	else
		printf '{"path":"%s","round":%s,"eng":%s,"ux":%s}\n' "$p" "$n" "$(child "$p" eng)" "$(child "$p" ux)"
	fi
}

# jstr S: S as a JSON string's body, escaped as Go's encoding/json does.
jstr() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/</\\u003c/g' -e 's/>/\\u003e/g' -e 's/&/\\u0026/g'
}

# spectitle ID: the spec's title on origin's main, else the ledger's.
spectitle() {
	f=$(git -C "$repo_path" ls-tree --name-only origin/main -- docs/proposals/ 2>/dev/null | grep "/$1-[^/]*\.md$" | sed -n 1p)
	if [ -n "$f" ]; then
		t=$(git -C "$repo_path" show "origin/main:$f" | awk 'NR == 1 && /^---$/ { fm = 1; next } fm && /^---$/ { exit } fm && /^title:/ { sub(/^title: */, ""); print; exit }')
		[ -n "$t" ] || t=$(basename "$f" .md | sed "s/^$1-//")
		printf '%s\n' "$t"
		return
	fi
	grep "^$1 " "$canned/spec-list" 2>/dev/null | cut -c39-
}

# fake_build: a lead started for each id, as the binary starts one whose
# spec nothing refuses (the fake has no live leads). One id prints its JSON
# object; several print a started line each and the family, or with
# --json one array of their objects. --accepted is answered from canned/
# only on an arm whose manual documents it; elsewhere it is the binary's
# unknown-flag refusal.
fake_build() {
	r=$(first "$@")
	if has accepted "$@"; then
		if ! grep -qxF -- 'build --accepted' "$cell/commands.txt"; then
			echo "bmesh: build: flag provided but not defined: -accepted" >&2
			exit 2
		fi
		out build-accepted || echo "no accepted specs in $r"
		return 0
	fi
	for id in $(positionals "$@" | sed 1d); do
		case $id in
		*[!0-9]*)
			echo "bmesh: spec id \"$id\" is not a number" >&2
			exit 2
			;;
		esac
	done
	ids=$(positionals "$@" | sed 1d | sed 's/^0*\([0-9]\)/\1/' | sort -n -u)
	n=$(printf '%s\n' "$ids" | grep -c .)
	if [ "$n" = 0 ]; then
		echo "bmesh: usage: bmesh build <repo> <NNN> [<NNN>...] [--model M] [--effort E] [--path P] [--family F] [--hold land|now] [--context <text|->] [--force]" >&2
		exit 2
	fi
	if [ "$n" -gt 1 ] && opt path "$@" >/dev/null; then
		echo "bmesh: --path names one lead; pick one spec with it" >&2
		exit 2
	fi
	fam=$(opt family "$@") || fam=$r-build-$(next family)
	model=$(opt model "$@") || model=claude-opus-5-5
	objs=
	for id in $ids; do
		id=$(pad "$id")
		p=$(opt path "$@") || p=$r-$id
		t=$(uuid "$(next thread)")
		fields=$(printf '"path":"%s","thread":"%s","branch":"bmesh/%s","worktree":"%s/worktrees/%s/%s","model":"%s","spec":"%s"' \
			"$p" "$t" "$t" "$cell" "$r" "$p" "$model" "$id")
		if [ "$n" = 1 ]; then
			printf '{%s,"family":"%s"}\n' "$fields" "$fam"
			return 0
		fi
		title=$(spectitle "$id")
		if [ $json = 1 ]; then
			objs=${objs:+$objs,}$(printf '{"id":"%s","title":"%s","state":"started","family":"%s",%s}' "$id" "$(jstr "$title")" "$fam" "$fields")
		else
			printf 'started %s %s: %s on %s (thread %s, branch bmesh/%s, family %s)\n' "$id" "$title" "$p" "$model" "$t" "$t" "$fam"
		fi
	done
	if [ $json = 1 ]; then
		printf '[%s]\n' "$objs"
	elif [ "$n" -gt 1 ]; then
		echo "family $fam"
	fi
}

fake_release() {
	r=$(first "$@")
	dir=$(repodir "$r")
	s=$(sha8 origin/main "$dir")
	[ -n "$s" ] || s=$(sha8 HEAD "$dir")
	if has dry-run "$@"; then
		echo "would release $r v0.1.0 at ${s:-00000000} (no specs); --dry-run tags nothing"
	else
		echo "released $r v0.1.0 at ${s:-00000000} (no specs)"
	fi
}

case $cmd in
help) usage ;;
version) echo "bmesh (skilltest's fake)" ;;
hosts)
	if has here "$@"; then
		out hosts-here || echo "this box is $host; secure: no; on the mesh: no other box"
	elif has notes "$@"; then
		echo "$host: no notes"
	else
		printf 'NAME  PRESENCE  ROLE\n%s   awake     admin\n' "$host"
	fi
	;;
update) has notice "$@" || echo "up to date" ;;
repos) fake_repos "$@" ;;
mesh-status) if [ $json = 1 ]; then out mesh-status.json; else out mesh-status; fi ;;
thread-status)
	p=$(first "$@")
	[ -n "$p" ] || p=$gnode
	[ -n "$p" ] || nonode
	if [ $json = 1 ]; then
		out "thread-status.$p.json" || echo '{"state":"idle","at":"","text":"","by":""}'
	else
		out "thread-status.$p" || echo idle
	fi
	;;
watch) out watch ;;
inbox)
	if [ -f "$state/mail" ]; then
		cat "$state/mail"
		rm -f "$state/mail"
	else
		out inbox || { [ $json = 1 ] || echo "inbox: empty"; }
	fi
	;;
spec) fake_spec "$@" ;;
routine) fake_routine "$@" ;;
ideate) fake_ideate "$@" ;;
build) fake_build "$@" ;;
lead)
	if [ "${1-}" = start ]; then
		p=$(opt path "$@") || p=$(opt repo "$@")-$(pad "$(opt spec "$@")")
		t=$(uuid "$(next thread)")
		printf '{"path":"%s","thread":"%s","branch":"bmesh/%s","worktree":"%s/worktrees/%s/%s"}\n' "$p" "$t" "$t" "$cell" "$repo" "$p"
	fi
	;;
executor) fake_executor "$@" ;;
choose-ideas) out choose-ideas || echo "landed $(fakesha | cut -c1-8) on main: Review: $(positionals "$@" | sed -n 2p)" ;;
land) fake_land "$@" ;;
ready) fake_ready "$@" ;;
held)
	[ -n "$gnode" ] || nonode
	echo "bmesh: refused: $gnode is not held (released already?); run bmesh inbox and carry on" >&2
	exit 3
	;;
done)
	[ -n "$gnode" ] || nonode
	echo "done $gnode $(opt commit "$@" | cut -c1-8)"
	;;
started | progress | blocked | ask)
	[ -n "$gnode" ] || nonode
	echo "$cmd $gnode"
	;;
whoami)
	[ -n "$gnode" ] || nonode
	echo "$gnode"
	;;
release) fake_release "$@" ;;
hold)
	p=$(opt family "$@") || p=$(first "$@")
	if [ "$(opt gate "$@")" = now ]; then
		echo "holding $p now: $(opt text "$@")"
	else
		echo "holding $p before land: $(opt text "$@")"
	fi
	;;
unhold)
	p=$(opt family "$@") || p=$(first "$@")
	echo "released $p"
	;;
node) [ "${1-}" = stop ] && echo "stopped $(positionals "$@" | sed -n 2p)" ;;
feedback)
	case ${1-} in
	list) ;;
	drain) echo "drained 0" ;;
	*) echo "feedback $(next feedback) in $repo-build-1" ;;
	esac
	;;
fix) echo "fix: $repo-fix-$(next fix) started (thread $(uuid "$(next thread)"), claude-opus-5-5, on $host)" ;;
send) echo "sent $(uuid "$(next message)")" ;;
esac
exit 0
